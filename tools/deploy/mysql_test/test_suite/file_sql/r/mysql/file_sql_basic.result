SET GLOBAL secure_file_priv = '/tmp/seekdb_file_sql_data';
SET GLOBAL enable_file_sql = true;
SET SESSION enable_file_sql = true;
CREATE DATABASE IF NOT EXISTS file_sql_test;
USE file_sql_test;
